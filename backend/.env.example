# Required application settings
DATABASE_URL=postgresql+psycopg://researchos_user:change-me@localhost:5433/researchos
# Optional local PostgreSQL URL used only as the credential source for a
# uniquely named, temporary pytest database. Must target researchos_test*.
TEST_DATABASE_URL=postgresql+psycopg://researchos_user:change-me@localhost:5433/researchos_test
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Select exactly one provider: gemini or ollama
LLM_PROVIDER=gemini

# Gemini (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (required when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Shared provider controls
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Web research
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
TAVILY_MIN_RELEVANCE_SCORE=
TAVILY_TIMEOUT_SECONDS=30
TAVILY_MAX_RETRIES=2

# Academic research
ACADEMIC_SEARCH_ENABLED=true
ACADEMIC_MAX_RESULTS=5
ACADEMIC_TIMEOUT_SECONDS=30
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=

# Embeddings and RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=
RAG_VECTOR_TOP_K=20
RAG_BM25_TOP_K=20
RAG_RRF_K=60
BM25_K1=1.5
BM25_B=0.75
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=
